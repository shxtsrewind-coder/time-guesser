{
  // Static-site deploy config for Cloudflare Workers (the current, unified
  // replacement for "classic" Cloudflare Pages). There's no server-side
  // Worker code here — this app is a built Vite SPA (dist/), and Workers'
  // static-assets mode serves it directly with no backend of its own.
  //
  // Build step (run by Cloudflare before deploy): `npm run build` → dist/
  // Deploy step: `npx wrangler deploy`
  "name": "when-and-where",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    // The app routes client-side with react-router's HashRouter
    // (#/play/..., #/leaderboard, ...), which is all still the same
    // physical URL (/) as far as the server is concerned — so a request
    // for any path that doesn't match a real file in dist/ should still
    // fall back to index.html rather than 404.
    "not_found_handling": "single-page-application"
  }
}
